# systemd unit template for one Telegram MCP ingest listener (pr-hero-xf6).
# Rendered per profile by deploy-sandbox-ik.sh → /etc/systemd/system/telegram-mcp-__PROFILE__.service
# Naming telegram-mcp-<profile> matches telegram_mcp_doctor.check_deploy_units +
# telegram_endpoints.py fetch_vps_endpoint (SwitchBar). One process per account =
# one long-lived Telethon session per endpoint (§Telegram session-per-endpoint).
[Unit]
Description=Telegram MCP ingest listener (__PROFILE__) → Supabase
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
# per-profile secrets (session string / TELEGRAM_USER / LABA_MODE) — NOT in git
EnvironmentFile=/etc/telegram-mcp/env.d/__PROFILE__.env
Environment=PYTHONPATH=__APP_DIR__
Environment=HEROES_CREDENTIALS_REGISTRY=__APP_DIR__/heroes_harness/credentials_registry.yaml
Environment=TELEGRAM_MCP_TRANSPORT=streamable-http
Environment=TELEGRAM_MCP_HOST=127.0.0.1
Environment=TELEGRAM_MCP_PORT=__MCP_PORT__
Environment=TELEGRAM_MCP_PATH=/mcp
Environment=TELEGRAM_MCP_SINGLE_PROFILE=true
# Both profile units share the Supabase session-mode pool.  The writer runs
# synchronously inside each asyncio process, so two connections per profile are
# sufficient and prevent the two services from reserving 16 sessions together.
Environment=TELEGRAM_PG_POOL_MIN=1
Environment=TELEGRAM_PG_POOL_MAX=2
Environment=BACKFILL_ON_STARTUP=false
# Deep history is a bounded maintenance startup mode.  Keep it off after the
# historical pass so a saturated database pool cannot delay MCP HTTP startup;
# the periodic forward catch-up remains scheduled by the listener.
Environment=DEEP_BACKFILL_IN_LISTENER=false
Environment=DEEP_BACKFILL_TOTAL_BUDGET=1000
Environment=DEEP_BACKFILL_PER_CHAT_LIMIT=250
Environment=DEEP_BACKFILL_SELECT_LIMIT=50
Environment=DEEP_BACKFILL_DEACTIVATE_UNRESOLVED=true
Environment=DEEP_BACKFILL_STARTUP_MAX_PASSES=200
ExecStart=__APP_DIR__/.venv/bin/python listener.py
Restart=on-failure
RestartSec=5
# graceful shutdown: give Telethon time to flush + disconnect cleanly
TimeoutStopSec=20
KillSignal=SIGTERM
# logs → journald (journalctl -u telegram-mcp-__PROFILE__), not /app/logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=telegram-mcp-__PROFILE__

[Install]
WantedBy=multi-user.target
Alias=telegram-mcp-__PROFILE__-remote.service
