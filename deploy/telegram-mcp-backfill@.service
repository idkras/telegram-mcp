[Unit]
Description=Telegram MCP forward catch-up + bounded history backfill (%i) → Supabase
After=network-online.target telegram-mcp-%i.service
Wants=network-online.target

[Service]
Type=oneshot
User=idkras
WorkingDirectory=/home/idkras/telegram-mcp-production
LoadCredentialEncrypted=telegram_env:/etc/credstore.encrypted/telegram-mcp-%i.env.cred
Environment=PYTHONPATH=/home/idkras/telegram-mcp-production
Environment=HEROES_CREDENTIALS_REGISTRY=/home/idkras/telegram-mcp-production/heroes_harness/credentials_registry.yaml
Environment=TELEGRAM_USER=%i
Environment=LABA_MODE=true
ExecStart=/home/idkras/telegram-mcp-production/.venv/bin/python deploy/run-with-encrypted-credential.py /home/idkras/telegram-mcp-production/.venv/bin/python scripts/catch_up_recent_telegram_to_supabase.py --profile %i --limit-messages 5000 --deep-backfill-budget 1000 --deep-backfill-per-chat 250 --deep-backfill-select-limit 50
TimeoutStartSec=20min
Nice=10
